# SQLite database location (absolute or relative to the prisma/ folder)
DATABASE_URL=file:/absolute/path/to/wasla/db/custom.db

# Session signing secret (falls back to a dev value if unset — set a strong one in production)
# AUTH_SECRET=change-me

# Shared secret between the Next.js app and the inbox mini-service
# SERVICE_SECRET=change-me

# Token for the scheduled-posts publisher worker
# WORKER_TOKEN=change-me
